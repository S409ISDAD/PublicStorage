#!/usr/bin/env bash
# Checks for Claude Code, installs it if missing, then launches it.
set -euo pipefail

# The native installer puts claude in ~/.local/bin, which may not be on PATH yet
export PATH="$HOME/.local/bin:$PATH"

if ! command -v claude >/dev/null 2>&1; then
    echo "Claude Code not found. Installing..."

    if ! command -v curl >/dev/null 2>&1; then
        sudo apt update && sudo apt install -y curl
    fi

    curl -fsSL https://claude.ai/install.sh | bash
    hash -r

    if ! command -v claude >/dev/null 2>&1; then
        echo "Install finished but claude still isn't on PATH. Check ~/.local/bin." >&2
        exit 1
    fi
    echo "Installed: $(claude --version 2>/dev/null || echo 'claude')"
fi

export IS_SANDBOX=1
exec claude --dangerously-skip-permissions "$@" < /dev/tty
